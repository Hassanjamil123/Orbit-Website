# Copy to .env.local for local development. Never commit real values.
# All of these are read server-side only; none are prefixed NEXT_PUBLIC_
# except NEXT_PUBLIC_SITE_URL, which is safe to expose.

# Canonical public URL (used for metadata, sitemap, and the same-origin check on form posts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storage driver: "file" (local dev only) or "supabase" (any hosted deployment)
STORAGE_DRIVER=file

# file driver: directory for JSONL data files (default ./data, git-ignored)
DATA_DIR=./data

# supabase driver: create the tables with supabase/schema.sql first.
# The service role key bypasses row-level security — keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin export: Bearer token for GET /api/admin/export. Export is disabled
# unless this is set to at least 32 characters. Generate with: openssl rand -hex 32
ADMIN_EXPORT_TOKEN=

# Secret used to hash client IPs for rate limiting (IPs are never stored).
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=
